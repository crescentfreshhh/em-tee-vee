# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# Spotify only allows http for loopback hosts (localhost / 127.0.0.1); for a
# LAN address use https or do the initial connect over an SSH tunnel.
SPOTIPY_REDIRECT_URI=http://localhost:5000/auth/callback

# Where videos + per-profile data (catalog, tokens) are stored.
MTV_DOWNLOAD_DIR=./videos

# Flask session secret. Set to a long random string in production.
MTV_SECRET_KEY=change-me-to-something-random

MTV_PORT=5000
